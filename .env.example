# Copier ce fichier en .env pour changer les réglages (aucun secret requis : tout tourne en local).
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
LLM_NUM_CTX=8192

# Dossiers
DOCS_DIR=data/docs
CHROMA_DIR=chroma_db

# Découpage et recherche (à calibrer avec `python -m rag_assistant eval`)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE=0.60
